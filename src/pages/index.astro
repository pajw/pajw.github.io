---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const description = 'Engineer, web & agents';

// Set this to a short two-or-three-sentence bio when ready; null hides the block.
const bio: string | null = null;

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

function formatDate(date: Date) {
  return date.toISOString().slice(0, 10);
}
---

<Layout title="Paul Wilson" description={description} variant="with-margin">
  <h1>Paul Wilson</h1>
  <p class="tagline">{description}</p>

  {bio && <p class="bio">{bio}</p>}

  <p class="links">
    <a href="https://github.com/pajw">GitHub</a>,
    <a href="https://linkedin.com/in/paul-wilson-9762b281">LinkedIn</a>,
    <a href="mailto:paul@pajwilson.com">Email</a>,
    <a href="/rss.xml">RSS</a>
  </p>

  {
    posts.length > 0 && (
      <>
        <h2>Writing</h2>
        <ul class="posts">
          {posts.map((post) => (
            <li>
              <div class="post-date">{formatDate(post.data.pubDate)}</div>
              <div>
                <a class="post-title" href={`/blog/${post.id}/`}>
                  {post.data.title}
                </a>
                <p class="post-desc">{post.data.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <Fragment slot="margin">
    <div class="note">
      <strong>Colophon</strong>
      Set in <em>Source Serif 4</em> with <em>Source Sans 3</em>; code in
      <code>IBM Plex Mono</code>.
    </div>
    <div class="note">
      <strong>Feed</strong>
      <a href="/rss.xml">RSS</a>.
    </div>
  </Fragment>
</Layout>
