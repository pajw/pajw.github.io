---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const description = 'Engineer, web & agents';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

function formatDate(date: Date) {
  return date.toISOString().slice(0, 10);
}
---

<Layout title="Paul Wilson" description={description} variant="with-margin">
  <h1>Paul Wilson</h1>
  <p class="tagline">{description}</p>

  {/* TODO: replace placeholder bio with two or three real sentences. */}
  <p class="bio">
    [Placeholder bio. Two or three sentences here on what you build, who
    you work with, and what you write about.]
  </p>

  <p class="links">
    <a href="https://github.com/pajw">GitHub</a>,
    <a href="https://linkedin.com/in/paul-wilson-9762b281">LinkedIn</a>,
    <a href="mailto:paul@pajwilson.com">Email</a>,
    <a href="/rss.xml">RSS</a>
  </p>

  <h2>Writing</h2>
  {
    posts.length === 0 ? (
      <p class="empty">Nothing here yet.</p>
    ) : (
      <ul class="posts">
        {posts.map((post) => (
          <li>
            <div class="post-date">{formatDate(post.data.pubDate)}</div>
            <div>
              <a class="post-title" href={`/blog/${post.id}/`}>
                {post.data.title}
              </a>
              <p class="post-desc">{post.data.description}</p>
            </div>
          </li>
        ))}
      </ul>
    )
  }

  <Fragment slot="margin">
    <div class="note">
      <strong>Colophon</strong>
      Set in <em>Source Serif 4</em> with <em>Source Sans 3</em>; code in
      <code>IBM Plex Mono</code>. Greyscale palette, colour reserved for
      figures.
    </div>
    <div class="note">
      <strong>Feed</strong>
      <a href="/rss.xml">RSS</a>, with all posts listed above.
    </div>
    <div class="note">
      <strong>Built with</strong>
      <a href="https://astro.build">Astro</a>, hosted on
      <a href="https://pages.github.com">GitHub Pages</a>. Source on
      <a href="https://github.com/pajw/pajw.github.io">GitHub</a>.
    </div>
  </Fragment>
</Layout>
