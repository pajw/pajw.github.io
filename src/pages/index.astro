---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const description = 'Engineer, web & agents';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

function formatDate(date: Date) {
  return date.toISOString().slice(0, 10);
}
---

<Layout title="Paul Wilson" description={description} wide>
  <h1>Paul Wilson</h1>
  <p class="tagline">{description}</p>
  <p class="intro-links">
    <a href="https://github.com/pajw">GitHub</a>,
    <a href="https://linkedin.com/in/paul-wilson-9762b281">LinkedIn</a>,
    <a href="mailto:paul@pajwilson.com">Email</a>
  </p>

  <section>
    <h2>Writing</h2>
    {
      posts.length === 0 ? (
        <p class="muted">Nothing here yet.</p>
      ) : (
        <ul class="posts">
          {posts.map((post) => (
            <li>
              <div class="post-date">{formatDate(post.data.pubDate)}</div>
              <a class="post-title" href={`/blog/${post.id}/`}>
                {post.data.title}
              </a>
              <p class="post-desc">{post.data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Layout>
