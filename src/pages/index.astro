---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const description = 'Engineer, web & agents';

// Two or three sentences once written. Leave as null to hide the block.
const bio: string | null = null;

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

function formatDate(date: Date) {
  return date.toISOString().slice(0, 10);
}
---

<Layout
  title="Paul Wilson"
  description={description}
  variant="home"
  folio="fol. i · home"
>
  <header class="masthead stagger">
    <h1>Paul Wilson</h1>
    <p class="tagline">{description}</p>
  </header>

  {bio && <p class="bio stagger">{bio}</p>}

  <p class="correspondence stagger">
    <a href="https://github.com/pajw">github</a>
    <span>·</span>
    <a href="https://linkedin.com/in/paul-wilson-9762b281">linkedin</a>
    <span>·</span>
    <a href="mailto:paul@pajwilson.com">paul@pajwilson.com</a>
    <span>·</span>
    <a href="/rss.xml">rss</a>
  </p>

  {
    posts.length > 0 && (
      <section class="writing stagger">
        <h2>Writing</h2>
        <ul class="posts">
          {posts.map((post) => (
            <li>
              <div class="post-date">{formatDate(post.data.pubDate)}</div>
              <div>
                <a class="post-title" href={`/blog/${post.id}/`}>
                  {post.data.title}
                </a>
                <p class="post-desc">{post.data.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <Fragment slot="margin">
    <div class="note stagger">
      <span class="pilcrow">¶ colophon</span>
      Set in <em>Fraunces</em> with <em>IBM Plex Mono</em> for the
      system voice. Warm paper by day, candlelit ink by night.
      Built with <a href="https://astro.build">Astro</a>.
    </div>
    <div class="note stagger">
      <span class="pilcrow">¶ source</span>
      <a href="https://github.com/pajw/pajw.github.io">on github</a>,
      hosted on <a href="https://pages.github.com">github pages</a>.
    </div>
    <div class="note stagger">
      <span class="pilcrow">¶ feed</span>
      <a href="/rss.xml">rss</a>, for those who keep a reader.
    </div>
  </Fragment>
</Layout>
